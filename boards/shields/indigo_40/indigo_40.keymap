#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &kp ESCAPE  &kp Q       &kp W       &kp E       &kp R       &kp T                   &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BACKSPACE
                &kp TAB     &kp A       &kp S       &kp D       &kp F       &kp G                   &kp H       &kp J       &kp K       &kp L       &kp APOS    &kp ENTER
                &kp LSHIFT  &kp Z       &kp X       &kp C       &kp V       &kp B       &kp B       &kp N       &kp M       &kp DOT     &kp COMMA   &kp UP      &kp RSHFT
                &kp LCTRL   &kp LGUI    &kp LALT    &studio_unlock          &kp SPACE   &kp SPACE               &kp RALT                &kp LEFT    &kp DOWN    &kp RIGHT
            >;
        };
    };
};