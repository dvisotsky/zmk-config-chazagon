#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &lt 1 N6 /* tap = N6, hold = layer 1 */
                &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P
                &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp ENTER
                &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp DOT     &kp RSHFT
                &kp LCTRL   &kp LALT    &kp SPACE   &kp RALT    &kp RCTRL   &kp LGUI    &kp SPACE   &kp RGUI
            >;
        };

        second_layer { // Layer 1
            display-name = "Layer 1";
            bindings = <
                &out OUT_TOG    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &studio_unlock  &trans
                &trans          &trans          &trans          &trans          &trans          &trans      &trans      &trans      &trans      &trans
                &trans          &trans          &trans          &trans          &trans          &trans      &trans      &trans      &trans      &trans
                &trans          &trans          &trans          &trans          &trans          &trans      &trans      &trans      &trans
                &trans          &trans          &trans          &trans          &trans          &trans      &trans      &trans
            >;
        };
    };
};